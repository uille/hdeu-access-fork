{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "applications": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "application_id": {
            "type": "string"
          }
        },
        "required": ["application_id"]
      }
    },
    "datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dataset_id": {
            "type": "string"
          },
          "distributions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "distribution_id": {
                  "type": "string"
                }
              },
              "required": ["distribution_id"]
            }
          }
        },
        "required": ["dataset_id", "distributions"]
      }
    }
  },
  "required": ["applications", "datasets"]
}
