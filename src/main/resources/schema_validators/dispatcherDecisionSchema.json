{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["type", "operation", "objectId", "payload"],
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "enum": ["application"]
    },
    "operation": {
      "type": "string",
      "enum": ["decision"]
    },
    "objectId": {
      "type": "string",
      "minLength": 1
    },
    "itbId": {
      "type": "string",
      "description": "ITB Identifier"
    },
    "payload": {
      "type": "object",
      "required": ["application_type", "status", "decisions", "catalog_id"],
      "additionalProperties": false,
      "properties": {
        "application_type": {
          "type": "string",
          "enum": ["DATA_ACCESS_APPLICATION", "DATA_REQUEST_APPLICATION"]
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "catalog_id": {
          "type": "string",
          "minLength": 1
        },
        "decisions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["dataset_id", "decision"],
            "additionalProperties": false,
            "properties": {
              "dataset_id": {
                "type": "string",
                "minLength": 1
              },
              "decision": {
                "type": "string",
                "enum": ["POSITIVE_DECISION_ISSUED", "POSITIVE_DECISION_ACCEPTED", "POSITIVE_DECISION_REJECTED", "NEGATIVE_DECISION_ISSUED", "NEGATIVE_DECISION_ACCEPTED", "NEGATIVE_DECISION_APPEALED", "APPEAL_APPROVED", "APPEAL_REJECTED", "WITHDRAWN"]
              },
              "decision_file": {
                "type": "string",
                "format": "byte",
                "description": "Base64-encoded Decision PDF file"
              },
              "decision_reason": {
                "type": "string",
                "maxLength": 2000,
                "description": "The reason for the decision taken by the reviewer."
              },
              "support_file": {
                "type": "string",
                "format": "byte",
                "description": "Base64-encoded Support PDF file"
              },
              "translatedFields": {
                "type": "object",
                "description": "Translated fields data"
              }
            }
          }
        }
      }
    }
  }
}
