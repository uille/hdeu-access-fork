{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": ["application"]
    },
    "operation": {
      "type": "string",
      "enum": ["decision"]
    },
    "objectId": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object",
      "properties": {
        "applicationType": {
          "type": "string",
          "enum": ["DATA_ACCESS_APPLICATION", "DATA_REQUEST_APPLICATION"]
        },
        "catalogId": {
          "type": "string",
          "minLength": 1
        },
        "decisions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "publisher": {
                "type": "string",
                "minLength": 1
              },
              "decision": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["publisher", "decision"]
          }
        }
      },
      "required": ["applicationType", "catalogId", "decisions"]
    }
  },
  "required": ["type", "operation", "objectId", "payload"]
}
