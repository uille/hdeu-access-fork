{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "userName": { "type": "string" },
        "legalOrNaturalPerson": {
          "type": "object",
          "required": ["key", "value"],
          "properties": {
            "key": { "type": "string", "enum": ["b"] },
            "value": { "type": "string" }
          }
        },
        "naturalPersonJobTitle": { "type": "string" },
        "naturalPersonAffiliation": { "type": "string" },
        "naturalPersonAddress": { "type": "string" },
        "naturalPersonZipCode": { "type": "string" },
        "naturalPersonCity": { "type": "string" },
        "naturalPersonCountry": {
          "type": "object",
          "required": ["key", "value"],
          "properties": {
            "key": { "type": "string" },
            "value": { "type": "string" }
          }
        },
        "naturalPersonPhone": {
          "type": "object",
          "required": ["countryCode", "number"],
          "properties": {
            "countryCode": { "type": "string" },
            "number": { "type": "string" }
          }
        },
        "_id": { "type": "string" },
        "date_created": { "type": "string", "format": "date-time" },
        "date_modified": { "type": "string", "format": "date-time" },
        "lastLoginAt": { "type": "string", "format": "date-time" },

        "emailNotificationPreferences": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "reminders"],
          "properties": {
            "enabled": { "type": "boolean" },
            "reminders": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled"],
              "properties": {
                "enabled": { "type": "boolean" },
                "offsetDays": {
                  "type": "array",
                  "items": { "type": "integer" },
                  "uniqueItems": true
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": { "enabled": { "const": true } },
                    "required": ["enabled"]
                  },
                  "then": {
                    "required": ["offsetDays"],
                    "properties": {
                      "offsetDays": { "minItems": 1 }
                    }
                  },
                  "else": {
                    "not": { "required": ["offsetDays"] }
                  }
                }
              ]
            }
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "legalOrNaturalPerson": {
          "type": "object",
          "required": ["key", "value"],
          "properties": {
            "key": { "type": "string", "enum": ["a"] },
            "value": { "type": "string" }
          }
        },
        "legalPersonOrganisationName": { "type": "string" },
        "legalPersonBusinessID": { "type": "string" },
        "legalPersonOperatorID": { "type": "string" },
        "legalPersonAddress": { "type": "string" },
        "legalPersonZipCode": { "type": "string" },
        "legalPersonCity": { "type": "string" },
        "legalPersonCountry": {
          "type": "object",
          "required": ["key", "value"],
          "properties": {
            "key": { "type": "string" },
            "value": { "type": "string" }
          }
        },
        "legalPersonPhone": {
          "type": "object",
          "required": ["countryCode", "number"],
          "properties": {
            "countryCode": { "type": "string" },
            "number": { "type": "string" }
          }
        },
        "_id": { "type": "string" },
        "date_created": { "type": "string", "format": "date-time" },
        "date_modified": { "type": "string", "format": "date-time" },
        "email": { "type": "string", "format": "email" },
        "userName": { "type": "string" },
        "lastLoginAt": { "type": "string", "format": "date-time" },

        "emailNotificationPreferences": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "reminders"],
          "properties": {
            "enabled": { "type": "boolean" },
            "reminders": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled"],
              "properties": {
                "enabled": { "type": "boolean" },
                "offsetDays": {
                  "type": "array",
                  "items": { "type": "integer" },
                  "uniqueItems": true
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": { "enabled": { "const": true } },
                    "required": ["enabled"]
                  },
                  "then": {
                    "required": ["offsetDays"],
                    "properties": {
                      "offsetDays": { "minItems": 1 }
                    }
                  },
                  "else": {
                    "not": { "required": ["offsetDays"] }
                  }
                }
              ]
            }
          }
        }
      },
      "additionalProperties": false
    }
  ]
}
