{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "type",
    "operation",
    "objectId",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "application"
      ]
    },
    "operation": {
      "type": "string",
      "enum": [
        "permit"
      ]
    },
    "objectId": {
      "type": "string",
      "minLength": 1
    },
    "itbId": {
      "type": "string",
      "description": "ITB Identifier"
    },
    "payload": {
      "type": "object",
      "required": [
        "application_type",
        "status",
        "permits"
      ],
      "additionalProperties": false,
      "properties": {
        "application_type": {
          "type": "string",
          "enum": [
            "DATA_ACCESS_APPLICATION",
            "DATA_REQUEST_APPLICATION"
          ]
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "catalog_id": {
          "type": "string",
          "minLength": 1,
          "description": "Catalog ID"
        },
        "permits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "dataset_id",
              "permit_status"
            ],
            "additionalProperties": false,
            "properties": {
              "dataset_id": {
                "type": "string",
                "minLength": 1
              },
              "permit_status": {
                "type": "string",
                "minLength": 1,
                "enum": ["GRANTED", "RENEWAL_REQUESTED", "RENEWED", "RENEWAL_REJECTED",
                  "EXPIRED", "AMENDMENT_REQUESTED", "AMENDED", "AMENDMENT_REJECTED", "REVOKED",
                  "REVOKE_APPEALED","APPEAL_APPROVED","APPEAL_REJECTED"]
              },
              "permit_file": {
                "type": "string",
                "format": "byte",
                "description": "Base64-encoded Permit PDF file"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "renew_amend_file": {
                "type": "string",
                "format": "byte",
                "description": "Base64-encoded PDF file"
              },
              "rejection_reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "rejection_file": {
                "type": "string",
                "format": "byte",
                "description": "Base64-encoded PDF file"
              },
              "revocation_file": {
                "type": "string",
                "format": "byte",
                "description": "Base64-encoded PDF file"
              },
              "permit_start_date": {
                "type": "string",
                "description": "Permit start date"
              },
              "permit_expiration_date": {
                "type": "string",
                "description": "Permit expiration date"
              },
              "permit_reference_number": {
                "type": "string",
                "description": "Permit reference number"
              },
              "permit_contact_details": {
                "type": "string",
                "description": "Permit contact details"
              },
              "translatedFields": {
                "type": "object",
                "description": "Translated fields data"
              }
            }
          }
        }
      }
    }
  }
}
