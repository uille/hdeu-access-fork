{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "inputLanguage": {
      "type": "string"
    },
    "datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dataset_id": {
            "type": "string"
          },
          "distributions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "distribution_id": {
                  "type": "string"
                }
              }
            },
            "required": ["distribution_id"]
          }
        }
      },
      "required": ["dataset_id"]
    }
  },
  "required": ["title"]
}
