{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["enabled", "reminders"],
  "properties": {
    "enabled": { "type": "boolean" },
    "reminders": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "offsetDays": {
          "type": "array",
          "items": { "type": "integer" },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "enabled": { "const": true } },
            "required": ["enabled"]
          },
          "then": {
            "required": ["offsetDays"],
            "properties": {
              "offsetDays": { "minItems": 1 }
            }
          },
          "else": {
            "not": { "required": ["offsetDays"] }
          }
        }
      ]
    }
  }
}
